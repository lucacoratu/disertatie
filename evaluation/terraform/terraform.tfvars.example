# Copy this file to terraform.tfvars and adjust the values to your OpenStack project
cloud                 = "openstack"       # name in clouds.yaml, or "" to use the OS_* environment variables
external_network_name = "public"
image_name            = "Ubuntu 24.04"
ssh_user              = "ubuntu"
central_flavor        = "m1.large"
agent_flavor          = "m1.medium"
public_key_path       = "~/.ssh/id_ed25519.pub"
private_key_path      = "~/.ssh/id_ed25519"

# Restrict the access to SSH, the dashboard and the API to your own address
admin_cidrs = ["203.0.113.0/24"]
