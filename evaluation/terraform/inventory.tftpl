# Generated by Terraform (evaluation/terraform). Do not edit, run terraform apply again instead.
[central]
central-vm ansible_host=${central_public_ip} private_ip=${central_private_ip}

[agents]
%{ for name, agent in agents ~}
agent-${name} ansible_host=${agent.public_ip} private_ip=${agent.private_ip} application=${agent.application}
%{ endfor ~}

[all:vars]
ansible_user=${ssh_user}
ansible_ssh_private_key_file=${private_key_path}
central_public_ip=${central_public_ip}
central_private_ip=${central_private_ip}
