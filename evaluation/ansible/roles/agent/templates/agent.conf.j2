{
    "protocol": "http",
    "address": "0.0.0.0",
    "port": "80",
    "forbiddenPagePath": "./static/forbidden.html",
    "blacklistUserAgentPath": "./lists/user_agent.list",
    "forwardServerProtocol": "http",
    "forwardServerAddress": "{{ application }}",
    "forwardServerPort": "{{ applications[application].port }}",
    "apiProtocol": "http",
    "apiIpAddress": "{{ central_private_ip }}",
    "apiPort": "{{ api_port }}",
    "uuid": "{{ agent_uuid }}",
    "rulesDirectory": "./rules",
    "operationMode": "{{ agent_operation_mode }}",
    "ignoreRulesDirectories": {{ agent_ignored_rule_directories | to_json }},
    "useAIClassifier": {{ agent_use_ai_classifier | bool | to_json }},
    "classifier": "{{ agent_classifier }}",
    "classifierProcesses": {{ agent_classifier_processes | int }},
    "pythonInterpreter": "/usr/local/bin/python",
    "llmAPIURL": "{{ llm_api_url }}",
    "createDataset": false,
    "datasetPath": "./datasets/dataset.csv",
    "adaptiveTemplates": []
}
