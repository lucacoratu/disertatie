# The inventory is generated by Terraform (evaluation/terraform) in inventory.ini.
# This example shows its format, for virtual machines created in another way.
[central]
central-vm ansible_host=203.0.113.10 private_ip=10.20.0.10

[agents]
agent-dvwa ansible_host=203.0.113.11 private_ip=10.20.0.11 application=dvwa
agent-juiceshop ansible_host=203.0.113.12 private_ip=10.20.0.12 application=juiceshop

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_ed25519
central_public_ip=203.0.113.10
central_private_ip=10.20.0.10
